# SASRE / Pépite - Variables d'environnement
# Copiez ce fichier en `.env.local` et renseignez vos valeurs

# === POCKETBASE ===
VITE_POCKETBASE_URL=https://pocketbase.example.com

# === FRANCE TRAVAIL API ===
# Obtenir les credentials sur: https://francetravail.io/
VITE_FT_CLIENT_ID=your_client_id_here
VITE_FT_CLIENT_SECRET=your_client_secret_here

# === OPENROUTER (IA - Recommandé) ===
# Clé API OpenRouter pour les appels LLM (accès à 100+ modèles)
# Obtenez-en une sur https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx

# === GOOGLE GEMINI (IA - Optionnel) ===
# https://aistudio.google.com/apikey
VITE_GOOGLE_API_KEY=

# === ANTHROPIC CLAUDE (IA - Optionnel) ===
# https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=

# === JINA AI (Scraping LinkedIn - Optionnel) ===
# https://jina.ai/reader
VITE_JINA_API_KEY=

# === GOTENBERG PDF (Génération PDF) ===
# URL du serveur Gotenberg pour génération de documents
# https://gotenberg.dev/
VITE_GOTENBERG_URL=

# === WELCOME TO THE JUNGLE (À venir) ===
# VITE_WTTJ_API_KEY=your_api_key_here
